  ],
  "language_notes": [
   {
    "sentence": 0,
    "kind": "word",
    "text": "\"Basement\" means the base or pedestal on which the bronze horse stood.",
    "spoiler": false
   },
   {
    "sentence": 2,
    "kind": "word",
    "text": "\"Tribes\" are the ten political divisions of Athenian citizens, each named after a hero.",
    "spoiler": false
   },
   {
    "sentence": 3,
    "kind": "word",
    "text": "\"Eponymi\" are the eponymous heroes, those who gave their names to the Athenian tribes.",
    "spoiler": false
   },
   {
    "sentence": 9,
    "kind": "word",
    "text": "\"Epigoni\" means \"the descendants\": the sons of the Seven, who later took Thebes.",
    "spoiler": false
   },
   {
    "sentence": 15,
    "kind": "phrasing",
    "text": "Picking out lice was a common act of intimacy and care; she lays his head in her lap to do so.",
    "spoiler": false
   },
   {
    "sentence": 16,
    "kind": "word",
    "text": "Æthra is glossed by the translator as meaning \"clear sky\", which makes the oracle's riddle work.",
    "spoiler": false
   }
  ],
  "context_notes": [
   {
    "sentence": 1,
    "text": "Miltiades commanded the Athenians at Marathon in 490 BC, where they defeated the Persians.",
    "spoiler": false
   },
   {
    "sentence": 5,
    "text": "Antigonus, Demetrius and Ptolemy were Macedonian-era rulers, successors of Alexander, who courted Greek favour with such gifts.",
    "spoiler": false
   },
   {
    "sentence": 10,
    "text": "Epaminondas, the Theban general, helped free the Messenians from Spartan rule and refounded Messene around 369 BC.",
    "spoiler": false
   },
   {
    "sentence": 11,
    "text": "Hypermnestra alone spared her husband Lynceus when the Danaids were ordered to kill their husbands on their wedding night.",
    "spoiler": false
   }
  ],
  "literary_notes": [
   {
    "sentence": 14,
    "device": "Irony",
    "text": "Phalanthus judges the oracle impossible, yet it is fulfilled in an unexpected way, showing the god's meaning was misread.",
    "spoiler": false
   },
   {
    "sentence": 15,
    "device": "Characterization",
    "text": "Her tender, practical comfort and sympathetic weeping portray the wife as devoted, and unknowingly the agent of the prophecy.",
    "spoiler": false
   },
   {
    "sentence": 16,
    "device": "Pun",
    "text": "The oracle's \"clear sky\" turns on his wife's name, Æthra: wordplay resolves the riddle and the tears become the rain.",
    "spoiler": false
   }
  ]
